<?xml version="1.0" encoding="utf-8"?>
<!--
  nuget.config (ADR-003): Legt die Paketquellen des Projekts explizit und
  versioniert fest, statt sich auf Maschinen-Defaults zu verlassen.
-->
<configuration>
  <packageSources>
    <!-- <clear /> entfernt alle geerbten Quellen (Maschinen-/Benutzerkonfig).
         Es gilt ausschließlich, was hier steht - sichere Defaults (A02:2025). -->
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>

  <!-- Package Source Mapping: Jedes Paketmuster ist fest einer Quelle
       zugeordnet. Verhindert Dependency-Confusion-Angriffe, bei denen ein
       gleichnamiges öffentliches Paket ein internes ersetzt. Heute mit nur
       einer Quelle eine Drei-Zeilen-Versicherung; kommt später ein interner
       Feed hinzu, wird hier ERWEITERT statt umgebaut. -->
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
