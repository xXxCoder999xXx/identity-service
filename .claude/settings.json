{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "shell": "powershell",
            "command": "& \"$env:CLAUDE_PROJECT_DIR\\.claude\\hooks\\Protect-Secrets.ps1\"; exit $LASTEXITCODE",
            "timeout": 15,
            "statusMessage": "Prüfe Zugriff auf Geheimnisse"
          },
          {
            "type": "command",
            "shell": "powershell",
            "command": "& \"$env:CLAUDE_PROJECT_DIR\\.claude\\hooks\\Test-CommitConvention.ps1\"; exit $LASTEXITCODE",
            "timeout": 15,
            "statusMessage": "Prüfe Commit-Konvention"
          }
        ]
      }
    ]
  },
  "permissions": {
    "deny": [
      "Read(/certs/**)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Bash(git push --force*)",
      "Bash(git push -f *)",
      "Bash(git push * --force*)",
      "Bash(git push * -f)",
      "Bash(git commit --no-verify*)",
      "Bash(git commit * --no-verify*)",
      "Bash(git commit --no-gpg-sign*)",
      "Bash(git commit * --no-gpg-sign*)",
      "Bash(dotnet add package *)",
      "Bash(dotnet add * package *)",
      "PowerShell(git push --force*)",
      "PowerShell(git push -f *)",
      "PowerShell(git push * --force*)",
      "PowerShell(git push * -f)",
      "PowerShell(git commit --no-verify*)",
      "PowerShell(git commit * --no-verify*)",
      "PowerShell(git commit --no-gpg-sign*)",
      "PowerShell(git commit * --no-gpg-sign*)",
      "PowerShell(dotnet add package *)",
      "PowerShell(dotnet add * package *)",
      "Bash(*gh pr merge*)",
      "Bash(*gh secret *)",
      "Bash(*gh variable *)",
      "Bash(*gh repo delete*)",
      "Bash(*gh repo edit*)",
      "Bash(*gh repo archive*)",
      "Bash(*gh repo rename*)",
      "Bash(*gh auth token*)",
      "Bash(*gh auth refresh*)",
      "Bash(*gh api --method *)",
      "Bash(*gh api -X *)",
      "Bash(*gh api * --method *)",
      "Bash(*gh api * -X *)",
      "Bash(*gh api * -f *)",
      "Bash(*gh api * -F *)",
      "Bash(*gh api * --field *)",
      "Bash(*gh api * --raw-field *)",
      "Bash(*gh api * --input *)",
      "PowerShell(*gh pr merge*)",
      "PowerShell(*gh secret *)",
      "PowerShell(*gh variable *)",
      "PowerShell(*gh repo delete*)",
      "PowerShell(*gh repo edit*)",
      "PowerShell(*gh repo archive*)",
      "PowerShell(*gh repo rename*)",
      "PowerShell(*gh auth token*)",
      "PowerShell(*gh auth refresh*)",
      "PowerShell(*gh api --method *)",
      "PowerShell(*gh api -X *)",
      "PowerShell(*gh api * --method *)",
      "PowerShell(*gh api * -X *)",
      "PowerShell(*gh api * -f *)",
      "PowerShell(*gh api * -F *)",
      "PowerShell(*gh api * --field *)",
      "PowerShell(*gh api * --raw-field *)",
      "PowerShell(*gh api * --input *)",
      "Bash(*gh.exe* pr merge*)",
      "Bash(*gh.exe* secret *)",
      "Bash(*gh.exe* variable *)",
      "Bash(*gh.exe* repo delete*)",
      "Bash(*gh.exe* auth token*)",
      "PowerShell(*gh.exe* pr merge*)",
      "PowerShell(*gh.exe* secret *)",
      "PowerShell(*gh.exe* variable *)",
      "PowerShell(*gh.exe* repo delete*)",
      "PowerShell(*gh.exe* auth token*)"
    ],
    "ask": [
      "Edit(/CLAUDE.md)",
      "Edit(/.claude/**)",
      "Edit(/.github/**)",
      "Edit(/Dockerfile)",
      "Edit(/.dockerignore)",
      "Edit(/compose.yaml)",
      "Edit(/nginx.conf)",
      "Edit(/scripts/**)",
      "Edit(/docs/governance/**)",
      "Edit(/Directory.Build.props)",
      "Edit(/Directory.Packages.props)",
      "Edit(/global.json)",
      "Edit(/nuget.config)",
      "Bash(git commit *)",
      "Bash(git push *)",
      "PowerShell(git commit *)",
      "PowerShell(git push *)",
      "Bash(git -c * push*)",
      "PowerShell(git -c * push*)",
      "Bash(*gh pr create*)",
      "Bash(*gh pr edit*)",
      "Bash(*gh pr close*)",
      "Bash(*gh pr reopen*)",
      "Bash(*gh pr ready*)",
      "Bash(*gh pr comment*)",
      "PowerShell(*gh pr create*)",
      "PowerShell(*gh pr edit*)",
      "PowerShell(*gh pr close*)",
      "PowerShell(*gh pr reopen*)",
      "PowerShell(*gh pr ready*)",
      "PowerShell(*gh pr comment*)"
    ],
    "allow": [
      "Bash(dotnet restore --locked-mode)",
      "Bash(dotnet build *)",
      "Bash(dotnet format --verify-no-changes *)",
      "Bash(dotnet test *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "PowerShell(dotnet restore --locked-mode)",
      "PowerShell(dotnet build *)",
      "PowerShell(dotnet format --verify-no-changes *)",
      "PowerShell(dotnet test *)",
      "PowerShell(git status *)",
      "PowerShell(git diff *)",
      "PowerShell(git log *)",
      "PowerShell(git show *)"
    ]
  }
}
