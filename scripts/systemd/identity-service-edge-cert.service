# Erneuert das Zertifikat von nginx auf Staging (E-5-76):
# scripts/renew-edge-certificate.sh. Gestartet von
# identity-service-edge-cert.timer.
# Ablageort: /etc/systemd/system, root:root, 0644.
#
# System-Unit mit User=deploy wie der Deploy (E-5-112): rootless Docker des
# Deploy-Benutzers, kein Docker-Socket in einem Container (E-5-76).
#
# Installation nach E-5-191:
#   /usr/local/lib/identity-service/renew-edge-certificate.sh   root 0755
#   /usr/local/lib/identity-service/lib/staging-runtime.sh      root 0644
#   /usr/local/lib/identity-service/lib/registry-only.sh        root 0644
#   /etc/credstore/identity-service-edge-cert.ping-url         root 0600
#     eigener Healthchecks-Check staging-edge-cert (E-5-104), Periode 1 Tag,
#     Grace 3 Stunden (wie staging-api-cert)
#
# Fehlt das Credential, startet systemd die Unit nicht; der ausbleibende Ping
# alarmiert (fail closed, ADR-013).
#
# Kein Token: Die Images liegen nach dem Deploy lokal (--pull never).
#
# StateDirectory teilt sie mit dem Deploy, nur wegen der gemeinsamen Sperre.
# StateDirectoryMode muss in allen drei Units gleich sein (Deploy,
# API-Neustart, diese): systemd setzt den Modus bei jedem Start.
#
# Netz (E-5-176): nur die Adressfamilien wie beim Deploy. Ein IP-Filter wie
# beim API-Neustart geht hier nicht: Der Ping geht an Healthchecks.io, deren
# Adressen nicht fest sind. Die Verbindung zu Let's Encrypt baut der Daemon
# auf, nicht diese Unit.
[Unit]
Description=Staging: Zertifikat von nginx erneuern (E-5-76)
Wants=network-online.target
After=network-online.target user@1001.service

[Service]
Type=oneshot
User=deploy
Group=deploy
ExecStart=/usr/local/lib/identity-service/renew-edge-certificate.sh /var/lib/identity-service-deploy
LoadCredential=ping-url:/etc/credstore/identity-service-edge-cert.ping-url
Environment=STAGING_SERVER_NAME_FILE=/etc/identity-service/server_name.conf
Environment=STAGING_CA_DIR=/etc/identity-service/ca
Environment=STAGING_API_CERT_DIR=/etc/identity-service/api-tls
Environment=DOCKER_HOST=unix:///run/user/1001/docker.sock
Environment=HOME=%t/identity-service-edge-cert
Environment=XDG_CONFIG_HOME=%t/identity-service-edge-cert/config
StateDirectory=identity-service-deploy
StateDirectoryMode=0700
RuntimeDirectory=identity-service-edge-cert
RuntimeDirectoryMode=0700
UMask=0077
# Wartet hoechstens 45 Minuten auf die Sperre (= TimeoutStartSec des Deploys),
# dann lego (bis 310 s), Aufraeumen, Neuladen, Health und Pruefung des
# ausgelieferten Zertifikats; zusammen hoechstens rund 57 Minuten (Rechnung
# im Skript).
TimeoutStartSec=58min
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=tmpfs
BindPaths=/run/user/1001/docker.sock
InaccessiblePaths=/etc/identity-service/ca-private /etc/credstore
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallFilter=@system-service
# Ein gesperrter Aufruf scheitert mit EPERM, statt den Prozess per SIGSYS zu
# beenden: So laeuft der EXIT-Trap des Skripts und der /fail-Ping geht raus.
SystemCallErrorNumber=EPERM
SystemCallArchitectures=native
