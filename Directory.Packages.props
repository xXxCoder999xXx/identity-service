<Project>
  <!--
    Central Package Management (ADR-003): Alle Paketversionen der gesamten
    Solution stehen genau einmal hier. In den .csproj-Dateien stehen
    PackageReference-Einträge OHNE Version-Attribut. Dieselbe OCP-Mechanik
    wie Directory.Build.props: neue Projekte erben die Governance automatisch.
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <!--
      WICHTIG (Regel 6.3.2, Slopsquatting-Prüfung): Verifiziere jedes Paket vor
      dem ersten Restore auf nuget.org - exakte Schreibweise, Herausgeber
      (Microsoft bzw. .NET Foundation / xUnit-Projekt), Downloadzahlen,
      Pflegezustand - und trage die aktuelle stabile Version ein.
    -->
    <!--
      xunit.v3 4.x läuft nur noch auf der Microsoft Testing Platform v2
      (ADR-002, Nachtrag). Das Testprojekt ist selbst das Programm; die
      VSTest-Pakete Microsoft.NET.Test.Sdk und xunit.runner.visualstudio
      entfallen bewusst (weniger Lieferkette, nur ein Testweg). Den Modus
      von dotnet test legt global.json fest ("test.runner").
    -->
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
  </ItemGroup>
</Project>
